<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_router" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tagline" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readiness_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_status_warning"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/readiness_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_required"
                android:textAllCaps="true"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/readiness_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/readiness_checking"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/readiness_message"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/readiness_checking_message" />

            <TextView
                android:id="@+id/setup_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/last_call_title" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp">

            <TextView
                android:id="@+id/last_call_result" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/last_call_none" android:textIsSelectable="true" />
        </LinearLayout>

        <TextView style="@style/SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/automation_title" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp">

            <Switch
                android:id="@+id/master" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="52dp"
                android:text="@string/master" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />

            <TextView android:id="@+id/master_help" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="16dp" android:layout_marginBottom="14dp"
                android:background="@color/outline" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/projection_label" android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView android:id="@+id/projection_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="@color/text_primary" android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/setup_title" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/permissions_step_title" />
            <TextView android:id="@+id/permissions_state" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <Button android:id="@+id/permissions" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/permissions_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:elevation="1dp" android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/target_step_title" />
            <TextView android:id="@+id/target_value" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <Button android:id="@+id/target" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/target_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_card"
            android:elevation="1dp" android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/authorization_step_title" />
            <TextView android:id="@+id/authorization_state" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <Button android:id="@+id/copy_adb" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/authorization_action" />
        </LinearLayout>

        <TextView style="@style/SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/test_title" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/BodyText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/test_help" />
            <Button android:id="@+id/route_now" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="@string/route_now" />
            <Button android:id="@+id/pause" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/pause" />
        </LinearLayout>

        <Button android:id="@+id/advanced_toggle" style="@style/QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/show_advanced" />

        <LinearLayout
            android:id="@+id/advanced_content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="18dp" android:visibility="gone">
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/competitor_title" />
            <TextView android:id="@+id/competitor_value" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <TextView style="@style/BodyText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/competitor_help" />
            <Button android:id="@+id/competitor" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/competitor_action" />
            <Button android:id="@+id/battery_settings" style="@style/QuietButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/battery_settings" />
        </LinearLayout>

        <Button android:id="@+id/diagnostics_toggle" style="@style/QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/show_diagnostics" />

        <LinearLayout
            android:id="@+id/diagnostics_content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="18dp" android:visibility="gone">
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/status_title" />
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:fontFamily="monospace" android:textColor="@color/text_secondary"
                android:textIsSelectable="true" android:textSize="12sp" />
            <Button android:id="@+id/refresh" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/refresh" />
            <TextView style="@style/CardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/logs_title" />
            <TextView android:id="@+id/logs" android:layout_width="match_parent"
                android:layout_height="220dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_diagnostics" android:fontFamily="monospace"
                android:padding="12dp" android:scrollbars="vertical"
                android:textColor="@color/diagnostic_text" android:textIsSelectable="true"
                android:textSize="11sp" />
            <Button android:id="@+id/export" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/export" />
            <Button android:id="@+id/report_wrong_audio" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/report_wrong_audio" />
        </LinearLayout>

        <TextView style="@style/SectionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/about_title" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/about_summary" />
            <TextView android:id="@+id/app_metadata" style="@style/BodyText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textIsSelectable="true" />
            <Button android:id="@+id/view_releases" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="@string/view_releases" />
            <Button android:id="@+id/view_source" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/view_source" />
            <Button android:id="@+id/report_issue" style="@style/QuietButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/report_issue" />
        </LinearLayout>

        <TextView style="@style/BodyText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:gravity="center" android:text="@string/privacy" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
